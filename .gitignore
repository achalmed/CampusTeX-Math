# ══════════════════════════════════════════════════════════════════
# .gitignore — CampusTeX-Preuniversitario (LuaLaTeX)
# Los PDF finales SÍ se versionan (material entregable a docentes).
# ══════════════════════════════════════════════════════════════════

# ── Auxiliares de compilación LaTeX ────────────────────────────────
*.aux
*.log
*.toc
*.out
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.bbl
*.blg
*.bcf
*.run.xml
*.nav
*.snm
*.vrb
*.xdv
*.dvi
# Variante corrupta detectada en la auditoría ("document synctex.gz")
* synctex.gz

# ── Directorios de build ───────────────────────────────────────────
build/
_build/

# ── Editores y sistema ─────────────────────────────────────────────
.directory
.DS_Store
Thumbs.db
*.swp
*~

# ── Anotaciones de clase (Xournal++) — binarios personales ─────────
# Comentar esta línea si se desea versionar las anotaciones.
*.xopp
